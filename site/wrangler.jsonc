// Deploys the built site (dist/) as static assets to the existing "seifomara" Worker,
// which already serves seifomara.com and www.seifomara.com.
{
  "name": "seifomara",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
